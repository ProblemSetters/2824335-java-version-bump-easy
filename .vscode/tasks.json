{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "mvn",
            "args": ["-B", "-ntp", "-DskipTests", "package"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Test",
            "type": "shell",
            "command": "bash",
            "args": ["test.sh"],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        }
    ]
}
